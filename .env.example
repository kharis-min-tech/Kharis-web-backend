PORT=4000
SUPABASE_URL=
# Server-only. Supabase dashboard > Project Settings > API Keys > service_role (or a secret key).
# Used for the public site reads, the forms and studio account management.
# Never put this in the studio or the websites.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Publishable (anon) key. The studio data routes use it with the signed-in editor's
# token so Row Level Security applies. They never fall back to the service role.
SUPABASE_ANON_KEY=your-anon-key
# Optional: only return rows for this workspace (the value of the `workspace` column).
# SUPABASE_WORKSPACE=
# Comma-separated origins allowed to call the API from a browser (the studio).
# The websites call from their servers, so they do not need to be listed.
CORS_ORIGINS=http://localhost:3002,https://content.kharis.org
# Invite and password reset emails link to {STUDIO_URL}/set-password.
STUDIO_URL=https://content.kharis.org
